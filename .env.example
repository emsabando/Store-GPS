# ---------------------------------------------------------------------------
# Store GPS environment configuration
# Copy this file to `.env` and fill in your values, then restart the servers.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) -------------------------------------------------------
# Which data source to use: "mock" (default, no setup) or "kroger" (live).
VITE_DATA_PROVIDER=mock

# Base URL of the proxy. Leave blank in dev — Vite proxies /api to the server.
# Set this only if you host the proxy on a different origin in production.
# VITE_PROXY_URL=

# --- Backend proxy (server/index.mjs) --------------------------------------
# Get these by registering an app at https://developer.kroger.com/
# (create account -> verify email -> register application -> copy credentials).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Port the proxy listens on (must match the Vite proxy target).
PORT=8787

# Kroger API base. Default is production; usually no need to change.
# KROGER_API_BASE=https://api.kroger.com/v1
