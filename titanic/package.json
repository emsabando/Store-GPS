    "fetch-textures": "node scripts/fetch-textures.mjs"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "8.3.5"
  }
}
